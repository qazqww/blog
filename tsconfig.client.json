{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "rootDir": "./src",
    "outDir": "./dist/assets",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/client/**/*.ts", "src/shared/**/*.ts"]
}
